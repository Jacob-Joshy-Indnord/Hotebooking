# RoomBook web: files git must not track. node_modules holds installed npm
# packages (rebuilt from package-lock.json with `npm ci`). .next and out are
# Next.js build output from `next build` / `next dev`. coverage is Vitest
# coverage output. next-env.d.ts is generated by Next.js on first run and
# depends on the local Next version, so it is not committed. *.tsbuildinfo is
# TypeScript's incremental build cache. .env*.local holds per-machine
# settings such as API_ORIGIN, the FastAPI address used by the /api rewrite
# in next.config.ts, and may contain secrets, so it stays local.
# No functions here; it is a plain ignore list read by git, one pattern per
# line, applying to everything under web/.
node_modules/
.next/
out/
coverage/
next-env.d.ts
*.tsbuildinfo
.env*.local
